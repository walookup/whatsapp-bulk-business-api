{
  "name": "WhatsApp bulk business check",
  "brand": "WA Lookup",
  "repository": "walookup/whatsapp-bulk-business-api",
  "description": "Check a whole list for WhatsApp Business accounts — separate from the activity check, this one answers only whether each number runs a Business account.",
  "official_site": "https://walookup.com",
  "landing_page": "https://walookup.com/products/ws_business_batch",
  "canonical_docs": "https://walookup.com/api-docs",
  "base_url": "https://walookup.com",
  "auth": {
    "type": "api_key",
    "header": "X-API-Key"
  },
  "mode": "async-bulk",
  "product": "ws_business_batch",
  "identifier_kind": "phone",
  "requires_country": true,
  "endpoints": {
    "submit": {
      "method": "POST",
      "path": "/api/v1/bulk-tasks"
    },
    "status": {
      "method": "GET",
      "path": "/api/v1/bulk-tasks/{id}"
    },
    "balance": {
      "method": "GET",
      "path": "/api/v1/balance"
    }
  },
  "limits": {
    "min_items": 1000,
    "max_items": 500000,
    "poll_interval_seconds": 30,
    "file_formats": [
      "txt",
      "csv"
    ]
  },
  "result_fields": [
    {
      "name": "identifier",
      "example": "12345678900",
      "description": "Submitted identifier, used to join the result to the input. Phone identifiers include their country code."
    },
    {
      "name": "activated",
      "example": "true",
      "description": "The determined positive/negative signal for this product; interpret it in the product context."
    },
    {
      "name": "business",
      "example": "false",
      "description": "WhatsApp Business-account status when determined."
    }
  ],
  "statuses": [
    "processing",
    "success",
    "failed"
  ],
  "pricing_url": "https://walookup.com/pricing",
  "maintainer": "WA Lookup",
  "license": "MIT",
  "last_reviewed": "2026-10-30"
}
